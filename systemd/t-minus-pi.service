[Unit]
Description=t-minus-pi MBTA Transit Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/t-minus-pi
ExecStart=/home/pi/t-minus-pi/.venv/bin/uvicorn src.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=-/home/pi/t-minus-pi/.env

[Install]
WantedBy=multi-user.target
